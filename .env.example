APP_ENV=development
APP_NAME=wecom-knowledge-bot
LOG_LEVEL=INFO
ADMIN_API_KEY=
KNOWLEDGE_UPLOAD_DIR=data/uploads
KNOWLEDGE_MAX_UPLOAD_MB=50
BUSINESS_TRASH_RETENTION_DAYS=7
BUSINESS_DRAFT_RETENTION_DAYS=7

# 企业微信参数请只填在本地 .env，禁止提交真实值
# 智能机器人长连接参数
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 企业身份与通讯录（成本价/采购价权限校验）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_SALES_DEPARTMENT_ID=
WECOM_DIRECTORY_CACHE_SECONDS=300
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# 数据库
DATABASE_URL=postgresql+psycopg://wecom_bot:change-me@localhost:5432/wecom_knowledge_bot
REDIS_URL=redis://localhost:6379/0

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# 第二阶段重排（可选；失败时自动退回本地重排）
RERANK_PROVIDER=local
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_ENABLED=true
RERANK_TIMEOUT_SECONDS=8
RERANK_CANDIDATE_LIMIT=20

RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_HISTORY_MESSAGES=6
RAG_MAX_CONTEXT_CHARS=12000
TASK_PLANNER_ENABLED=true
INTENT_CONFIDENCE_THRESHOLD=0.45
# 产品查询统一使用 V2 结构化链路，不再配置旧链路切换开关。
# 仅在已完成数据库备份与灰度验证后启用；会自动初始化 LangGraph checkpoint 表。
LANGGRAPH_CHECKPOINT_ENABLED=false
LANGGRAPH_CHECKPOINT_POOL_SIZE=4
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
